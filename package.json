{
  "name": "astra-qunxing",
  "private": true,
  "version": "1.0.0",
  "description": "《Astra:群星计划》—— 月球南极基地策略叙事网页游戏（Three.js）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
